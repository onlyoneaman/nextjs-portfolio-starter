# Copy this file to .env.local and fill in what you need. Everything here is optional.

# Base URL of your deployed site. Used for sitemap and RSS generation.
SITE_URL=https://example.com

# Google Analytics measurement ID (e.g. G-XXXXXXX). Leave blank to disable.
NEXT_PUBLIC_MEASUREMENT_ID=

# PostHog product analytics. Leave blank to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
